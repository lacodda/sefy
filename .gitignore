*.sefy-tmp

# Docs site (Astro Starlight)
docs/node_modules/
docs/dist/
docs/.astro/

# npm wrapper: binaries downloaded by install.js
npm/sefy
npm/sefy.exe
npm/archive.*
npm/node_modules/
