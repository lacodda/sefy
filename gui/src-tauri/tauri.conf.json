{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sefy",
  "mainBinaryName": "sefy-gui",
  "identifier": "com.lacodda.sefy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sefy",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "generalAutofillEnabled": false,
        "backgroundColor": "#171a1d",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll"
      },
      {
        "label": "quick",
        "create": false,
        "url": "quick.html",
        "title": "sefy",
        "width": 560,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true,
        "shadow": true,
        "dragDropEnabled": false,
        "generalAutofillEnabled": false,
        "backgroundColor": "#171a1d",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "appimage"
    ],
    "icon": [
      "../../assets/logo-512.png",
      "../../crates/sefy-cli/assets/icon.ico"
    ],
    "shortDescription": "An inconspicuous encrypted vault.",
    "longDescription": "sefy keeps notes, credentials and files in one file that looks like nothing in particular: no signature, no extension, nothing to mark it as a secret store."
  }
}
